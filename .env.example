# Local data and DuckDB catalog/telemetry
CHUNKSCOPE_DATA_DIR=data/volumes
CHUNKSCOPE_DB=data/telemetry.duckdb
CHUNKSCOPE_CACHE_BYTES=134217728
CHUNKSCOPE_MAX_PREVIEW_DIM=96
CHUNKSCOPE_MAX_CHUNKS=20000
CHUNKSCOPE_MAX_CHUNK_BYTES=67108864
CHUNKSCOPE_MAX_SLICE_VOXELS=16777216
CHUNKSCOPE_SAMPLE_SIZE=96
CHUNKSCOPE_SAMPLE_CHUNK=24
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Optional: configured bucket and prefix limit which remote Zarr locations may be opened.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PREFIX=
S3_REGION=us-east-1
S3_USE_TLS=true
